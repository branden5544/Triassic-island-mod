{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "half": "lower"
      },
      "apply": {
        "model": "triassicisland:block/sliding_glass_door_lower"
      }
    },
    {
      "when": {
        "facing": "north",
        "half": "upper"
      },
      "apply": {
        "model": "triassicisland:block/sliding_glass_door_upper"
      }
    },
    {
      "when": {
        "facing": "east",
        "half": "lower"
      },
      "apply": {
        "model": "triassicisland:block/sliding_glass_door_lower",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "half": "upper"
      },
      "apply": {
        "model": "triassicisland:block/sliding_glass_door_upper",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "half": "lower"
      },
      "apply": {
        "model": "triassicisland:block/sliding_glass_door_lower",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "half": "upper"
      },
      "apply": {
        "model": "triassicisland:block/sliding_glass_door_upper",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "half": "lower"
      },
      "apply": {
        "model": "triassicisland:block/sliding_glass_door_lower",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "half": "upper"
      },
      "apply": {
        "model": "triassicisland:block/sliding_glass_door_upper",
        "y": 270
      }
    }
  ]
}
